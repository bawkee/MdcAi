<?xml version="1.0" encoding="utf-8"?>

<local:OpenRouterSettingsPageBase
  x:Class="MdcAi.ChatUI.Views.OpenRouterSettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:MdcAi.ChatUI.Views"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls"
  xmlns:salaConverters="using:RxUIExt.WinUI.SalaConverters"
  mc:Ignorable="d"
  Background="Transparent">

  <Page.Resources>
    <salaConverters:NullToVisibilityConverter x:Key="NullToVisibilityConverterInv" />
  </Page.Resources>

  <controls:SettingsExpander x:Name="ApiExpander"
                             Header="OpenRouter API Access"
                             HeaderIcon="Permissions"
                             Description="OpenRouter is an OpenAI-compatible gateway to hundreds of models (Claude, DeepSeek, Llama, Gemini, ...). Your key is saved to your account's Windows Credentials and only you can access them.">
    <controls:SettingsExpander.Items>
      <controls:SettingsCard Header="API Key">
        <controls:SettingsCard.Description>
          <RichTextBlock>
            <Paragraph>
              Enter your OpenRouter API key here. Keys start with <Run FontFamily="Consolas">sk-or-v1-</Run> and are created at <Hyperlink NavigateUri="https://openrouter.ai/keys">openrouter.ai/keys</Hyperlink>.
            </Paragraph>
          </RichTextBlock>
        </controls:SettingsCard.Description>
        <StackPanel>
          <TextBox MinWidth="400"
                   AcceptsReturn="True"
                   IsSpellCheckEnabled="False"
                   Text="{x:Bind ViewModel.ApiKey, Mode=TwoWay, TargetNullValue='{x:Null}'}" />
          <HyperlinkButton Content="Remove Key"
                           Click="RemoveKey_OnClick"
                           Margin="0,10,0,0"
                           Visibility="{x:Bind ViewModel.ApiKey, Mode=OneWay, Converter={StaticResource NullToVisibilityConverterInv}}" />
        </StackPanel>
      </controls:SettingsCard>

      <controls:SettingsCard Header="App URL (HTTP-Referer)">
        <controls:SettingsCard.Description>
          <RichTextBlock>
            <Paragraph>
              OpenRouter attribution so it can rank providers properly. Leave empty to use <Run FontFamily="Consolas">http://localhost:3431/</Run>.
            </Paragraph>
          </RichTextBlock>
        </controls:SettingsCard.Description>
        <TextBox MinWidth="400"
                 IsSpellCheckEnabled="False"
                 Text="{x:Bind ViewModel.RefererUrl, Mode=TwoWay}" />
      </controls:SettingsCard>

      <controls:SettingsCard Header="App Title (X-OpenRouter-Title)">
        <controls:SettingsCard.Description>
          <RichTextBlock>
            <Paragraph>
              The app name sent to OpenRouter. Leave empty to use <Run FontFamily="Consolas">MDC AI</Run>.
            </Paragraph>
          </RichTextBlock>
        </controls:SettingsCard.Description>
        <TextBox MinWidth="400"
                 IsSpellCheckEnabled="False"
                 Text="{x:Bind ViewModel.AppTitle, Mode=TwoWay}" />
      </controls:SettingsCard>

    </controls:SettingsExpander.Items>

  </controls:SettingsExpander>
</local:OpenRouterSettingsPageBase>